<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Airbrush Time - Un programa de televisión que combina arte y tecnología con aerografía.">
    <title>Airbrush Time</title>
    <link rel="stylesheet" href="styles.css">
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script defer src="script.js"></script>
</head>
<body>

    <!-- Menú de navegación moderno -->
    <header class="header">
        <div class="logo">AIRBRUSH TIME 🎨</div>
        <nav>
            <ul class="nav-links">
                <li><a href="#inicio">Inicio</a></li>
                <li><a href="#servicios">Servicios</a></li>
                <li><a href="#galeria">Galería</a></li>
                <li><a href="#contacto">Contacto</a></li>
            </ul>
        </nav>
        <button class="menu-toggle" aria-label="Abrir menú" onclick="toggleMenu()">☰</button>
    </header>

    <main>
        <!-- Sección Hero -->
        <section id="inicio" class="hero">
            <h1>Arte en Cada Trazo</h1>
            <p>Aerografía profesional en todas las superficies.</p>
            <a href="#servicios" class="btn-neon">Ver Servicios</a>
        </section>

        <!-- Sección Servicios -->
        <section id="servicios" class="servicios">
            <h2>Nuestros Servicios</h2>
            <div class="servicios-grid">
                <article class="card">
                    <h3>Personalización Textil</h3>
                    <p>Diseños únicos en ropa y accesorios.</p>
                </article>
                <article class="card">
                    <h3>Pintura sobre Madera</h3>
                    <p>Creaciones artísticas en madera con aerografía.</p>
                </article>
                <article class="card">
                    <h3>Cursos de Aerografía</h3>
                    <p>Aprende técnicas avanzadas con nuestros expertos.</p>
                </article>
            </div>
        </section>

        <!-- Sección Galería -->
        <section id="galeria" class="galeria">
            <h2>Galería de Trabajos</h2>
            <div class="galeria-grid">
                <img src="img1.jpg" alt="Arte en aerografía 1">
                <img src="img2.jpg" alt="Arte en aerografía 2">
                <img src="img3.jpg" alt="Arte en aerografía 3">
            </div>
        </section>

        <!-- Sección Contacto -->
        <section id="contacto" class="contacto">
            <h2>Contacto</h2>
            <p>📍 Bogotá, Colombia</p>
            <p>📧 <a href="mailto:inf.airbrush.time@gmail.com">inf.airbrush.time@gmail.com</a></p>
            <p>📞 <a href="https://wa.me/573013069707" target="_blank">WhatsApp</a></p>
        </section>
    </main>

</body>
</html>
